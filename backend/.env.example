SECRET_KEY=change_me

# Dashboard basic auth
DASHBOARD_USER=kronos
DASHBOARD_PASSWORD=change_me

# Alpaca (US stocks paper trading)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# OANDA (forex practice account) — optional
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id

# Discord notifications — optional
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_NOTIFICATIONS_ENABLED=true

# Paper trading starting balances (USD)
PAPER_BALANCE_CRYPTO=1000
PAPER_BALANCE_STOCKS=1000
PAPER_BALANCE_FOREX=1000

# Prediction engine (overrides settings.json if set)
PREDICTION_INTERVAL_MINUTES=60
PREDICTION_HORIZON=24
SAMPLE_COUNT=5
LOOKBACK_CANDLES=400

# Audit system (uses claude -p headless, no API key needed)
AUDIT_LOOKBACK_DAYS_WEEKLY=7
AUDIT_LOOKBACK_DAYS_MONTHLY=30
AUDIT_CLAUDE_TIMEOUT_SEC=120
# Optional: hardcode path if systemd service can't find claude on PATH
# CLAUDE_BINARY=/home/<user>/.npm-global/bin/claude
